# Normalise line endings so a Windows checkout never shows every file as
# modified. Text files are LF in the repository, native in the working tree.
* text=auto

*.php   text eol=lf
*.sql   text eol=lf
*.css   text eol=lf
*.js    text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
.htaccess text eol=lf
.env.example text eol=lf

# Files that must keep LF regardless of platform — these run inside Linux
# containers and break with CRLF.
*.sh              text eol=lf
Dockerfile        text eol=lf
docker/**/*       text eol=lf
entrypoint.sh     text eol=lf

# Binary assets: never diff or convert.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.svg   text eol=lf
*.woff  binary
*.woff2 binary
*.ttf   binary
*.eot   binary
*.pdf   binary
*.zip   binary
