# =====================================================================
#  vuyanimagibisela.co.za — environment configuration
#
#  Copy to .env and fill in.  .env is git-ignored and must stay that way.
#      cp .env.example .env
#
#  Precedence: real environment variables > .env file > code defaults.
# =====================================================================

# ---------- Application ----------------------------------------------
APP_ENV=local
APP_DEBUG=true

# Full origin used when building links inside emails.
APP_URL=http://localhost:8090

# URL prefix for internal links.
#   Docker (DocumentRoot = public/)  ->  ""   (empty)
#   cPanel (root .htaccess redirect) ->  "/public"
APP_BASE_URL=

# ---------- Docker host ports -----------------------------------------
# Chosen to stay clear of the sci-bono projects on this machine, which
# already claim 8080, 8081, 8082, 8000, 8001, 5050, 5173, 5174, 3306,
# 3308 and 5433. `dev.ps1 up` re-checks for conflicts before starting.
APP_PORT=8090
PMA_PORT=8091
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025
DB_HOST_PORT=3307

# ---------- Database ---------------------------------------------------
# DB_HOST is the compose service name; from the Windows host use
# 127.0.0.1 with DB_HOST_PORT instead.
DB_HOST=db
DB_PORT=3306
DB_NAME=vuyanim
DB_USER=vuyanim
DB_PASSWORD=change-me-locally
DB_ROOT_PASSWORD=change-me-locally
DB_CHARSET=utf8mb4

# ---------- Mail -------------------------------------------------------
# Local development points at Mailpit: no auth, no TLS, nothing leaves
# the machine. Open http://localhost:8025 to read captured mail.
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAIL_AUTH=false

MAIL_FROM_EMAIL=admin@vuyanimagibisela.co.za
MAIL_FROM_NAME="Vuyani Magibisela"
MAIL_ADMIN_EMAIL=admin@vuyanimagibisela.co.za
MAIL_ADMIN_NAME="Vuyani Magibisela"

# Production values, for reference — set these in the server's own .env,
# never here:
#   MAIL_HOST=mail.vuyanimagibisela.co.za
#   MAIL_PORT=465
#   MAIL_ENCRYPTION=ssl
#   MAIL_AUTH=true
#   MAIL_USERNAME=admin@vuyanimagibisela.co.za
#   MAIL_PASSWORD=<rotate this — the old one was committed to git>

# ---------- Xdebug -----------------------------------------------------
# "off" to disable, "debug,develop" for breakpoints + better error output.
XDEBUG_MODE=debug,develop
